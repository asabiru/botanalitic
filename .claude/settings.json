{
  "$schema": "https://json.schemastore.org/claude-code-settings",
  "project": {
    "name": "finance-birge",
    "description": "Custodial Managed Trading Platform + Signal Subscription. Source of truth: final-tz-v1.5.md."
  },
  "policies": {
    "sourceOfTruth": "final-tz-v1.5.md",
    "criticalPaths": [
      "src/modules/ledger/**",
      "src/modules/withdrawals/**",
      "src/modules/deposits/**",
      "src/modules/risk/**",
      "src/workflows/**",
      "packages/ledger/**",
      "packages/risk/**",
      "services/signing/**",
      "services/temporal-worker/**",
      "prisma/schema.prisma",
      "prisma/migrations/**"
    ],
    "founderApprovalRequiredFor": [
      "ledger model changes",
      "client balance logic",
      "withdrawal flow",
      "custody architecture",
      "fee model",
      "high-water mark logic",
      "trading strategy",
      "real-money trading behavior",
      "risk limits",
      "KYC/AML logic",
      "legal wording",
      "private key/signing architecture",
      "production deployment",
      "emergency stop logic"
    ],
    "forbiddenPhrases": [
      "guaranteed profit",
      "risk-free",
      "no risk",
      "stable income",
      "safe trading",
      "100% signal",
      "passive income without losses",
      "гарантированная прибыль",
      "без риска",
      "стабильный доход",
      "безопасная торговля",
      "100% сигнал",
      "пассивный доход без потерь"
    ]
  },
  "decisionBoard": "docs/decision-board.md",
  "dailyReport": "docs/daily-agent-report.md",
  "weeklyBrief": "docs/weekly-founder-brief.md",
  "rfcDir": "docs/rfc/",
  "adrDir": "docs/adr/",
  "knownRisksRegister": "docs/known-risks-register.md"
}
