NODE_ENV=development
PORT=3000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Application
APP_BASE_URL=http://localhost:3000
ADMIN_CHAT_ID=
LOG_LEVEL=info

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me
YOOKASSA_WEBHOOK_URL=http://localhost:3000/webhooks/yookassa

# AI provider
# OPENAI_API_KEY включает реальный AI-анализ и сентимент по новостям через GPT.
# Без ключа отчёт собирается из детерминированного шаблона + эвристики по ключевым словам.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini